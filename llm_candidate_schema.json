{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uav-hrl-llm-shared-feature-candidate-v2",
  "title": "UAV HRL current-only shared state/reward feature candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_name",
    "reward_input_mode",
    "features",
    "code"
  ],
  "properties": {
    "schema_version": {"const": "uav-hrl-llm-shared-feature-candidate-v2"},
    "candidate_name": {"type": "string", "minLength": 1},
    "reward_input_mode": {"const": "current_only"},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    },
    "code": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "dtype",
        "description",
        "range",
        "source_fields",
        "formula",
        "missing_data_rule",
        "reward_weight"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "dtype": {"const": "float32"},
        "description": {"type": "string", "minLength": 1},
        "range": {"$ref": "#/$defs/range"},
        "source_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "formula": {"type": "string", "minLength": 1},
        "missing_data_rule": {"type": "string", "minLength": 1},
        "reward_weight": {"type": "number"}
      }
    }
  }
}
